{
  "name": "@printchecks/vue",
  "version": "1.0.1",
  "description": "Vue 3 integration layer for PrintChecks core library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js",
      "require": "./dist/composables/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "printchecks",
    "vue",
    "vue3",
    "checks",
    "receipts",
    "banking"
  ],
  "author": "PrintChecks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danford/PrintChecks.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Danford/PrintChecks#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@printchecks/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}