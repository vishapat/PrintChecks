{
  "name": "@printchecks/app",
  "version": "1.0.0",
  "description": "Professional check printing and payment documentation system that runs locally in your browser",
  "private": true,
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "dev:clear": "node scripts/clear-history.js",
    "cleanup": "node scripts/cleanup-debug.js",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "bootstrap": "5.3.8",
    "pinia": "4.1.0",
    "print-js": "1.6.0",
    "printjs": "1.1.0",
    "to-words": "7.4.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
